# Git Ignore for AI LLM Workspace

# Large data files / Raw Dumps
.context/raw_data/*.json
.context/raw_data/**/*.json
.context/artifacts/*.json
.context/knowledge/*.db
.context/knowledge/*.bz2
.context/drafts/

# macOS system files
.DS_Store
**/.DS_Store

# Temporary files
*.tmp
*.bak
*~

# IDE/Editor files
.vscode/
.idea/

# Agent internal state
.gemini/

# Python cache (recursive)
**/__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Runtime artifacts
athenad.log
athenad.log.*
*.pid

# Vector databases / Caches (regenerate from scripts)
.agent/chroma_db/
.agent/graphrag/output/
.agent/graphrag/*.gpickle
.agent/state/
!.agent/state/Decision_Log.md
!.agent/state/ADR-*.md

# Large binary assets (PDFs, PPTX — never diff)
.context/ventures/**/*.pdf
.context/ventures/**/*.pptx

# Virtual environments
.venv/

# Environment variables — committed to private repo (user-accepted risk)
# Backup: 100% coverage. Risk: private repo syncs to public mirror (mitigated by public .gitignore + pre-commit hook)
# If risk tolerance changes: git rm --cached .env, rotate keys, store in password manager


# Node.js (all sub-projects)
**/node_modules/

# MU (Machine Understanding)
.mu/
.agent/graphrag_env/

# Logs
telegram_bot.log
tuition-starter/
.agent/logs/

# SQLite artifacts
*.db-journal
*.db-wal
*.db-shm

# Personal Data (NEVER EXPOSE)
Winston/
.agent/skills/sickn33_collection
Athena-Public.wiki
winstonkoh87/
winstonkoh87.github.io/

# Ignore nested and corrupted git repos
.context/*/backups/
.agent/skills/sickn33_collection/
.projects/
.agent/skills/value-realization/value-realization/
winstonkoh87.github.io/


# Ignore nested public repository
Athena-Public/
FX Trading/
.tmp.driveupload
.tmp.drivedownload

# Generated indexes (regenerated on demand — 1.6MB combined)
.context/TAG_INDEX_A-M.md
.context/TAG_INDEX_N-Z.md

# Domain report-up digests (regenerated by sync_domain_digest.py; indexed from
# disk by supabase_sync, so tracking them in git is redundant + churns finance data)
.context/domains/*/DIGEST.md

# Git filter-branch artifacts
.git-rewrite/

# Claude agent artifacts
.claude/*
!.claude/settings.json

# Stale search results
search_results.txt
.env

# Daemon-written runtime telemetry — never track (jams pushes)
.agent/telemetry/retrieval_log.jsonl
.athena/invocations.jsonl

# SQLite databases (too large for GitHub file size limits)
**/*.db

.agent/models/reranker-onnx/model.onnx

# Daemon-written telemetry (S501 fix class — tracked+live-written files jam every pull)
.agent/telemetry/vector_sync.log
.context/telemetry/
