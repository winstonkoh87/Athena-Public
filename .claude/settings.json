{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agent/scripts/athena-py\" .agent/scripts/hook_meta_awareness_gate.py",
            "timeout": 5,
            "statusMessage": "Meta-awareness gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agent/scripts/athena-py\" .agent/scripts/security/block_secrets.py",
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Secret protection gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agent/scripts/athena-py\" .agent/scripts/security/block_ruin.py",
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Ruin protection gate (Law #1)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agent/scripts/athena-py\" .agent/scripts/hook_stop_verify.py",
            "timeout": 8,
            "statusMessage": "Output verifier (LaTeX/ASCII/secrets)"
          }
        ]
      }
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:15"
  }
}
